# ---- Build output (regenerated by mkdocs; never commit) ----
site/

# ---- Generated docs/ (regenerated from content/ by sync_docs.py) ----
# docs/ is a BUILD ARTIFACT: sync_docs.py copies content/ into it and (locally)
# also pulls in heavy course materials that must never be published. We never
# commit docs/. CI regenerates it from content/ before building. This keeps the
# repo small and guarantees no local-only material is published.
docs/

# ---- Agent index (regenerated by ask.py --reindex) ----
agent/kb_index.json

# ---- Python caches / envs ----
__pycache__/
*.pyc
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# ---- Logs & scratch ----
*.log
*.tmp

# ---- Secrets / credentials (must NEVER be committed) ----
*.pem
*.key
*.pfx
*.p12
*.env
.env
credentials
aws-credentials*
*.crt

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
