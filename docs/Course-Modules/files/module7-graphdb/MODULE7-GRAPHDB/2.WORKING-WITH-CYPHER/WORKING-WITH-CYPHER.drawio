        <mxCell id="MAjoo9X92PtXpeahRK0Q-24" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Note: If we don&#39;t want to mention the property in the { } we can use WHERE Clause to return required details&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1170" y="10712.5" width="840" height="67.5" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-25" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;6. Adding more logics&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="890" y="10890" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-26" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;WHERE p.name = &#39;Tom Hanks&#39; OR p.name = &#39;Rita Wilson&#39;&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;RETURN p.born&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1260" y="11032.5" width="690" height="107.5" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-27" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Syntax&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1355" y="10962.5" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-28" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Note: When you feel like printing only specific details not everything&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1170" y="11152.5" width="815" height="30" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-29" value="&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Georgia Pro&amp;quot;;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Name labels using CamelCase. Like &lt;b&gt;company&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/font&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Georgia Pro&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Name property keys and variables using camelCase. Like &lt;b&gt;personName&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/font&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Georgia Pro&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Use UPPERCASE for Cypher keywords. Like &lt;b&gt;NODE&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;verticalAlign=middle;fontSize=12;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1012.5" y="11340" width="730" height="160" as="geometry" />
