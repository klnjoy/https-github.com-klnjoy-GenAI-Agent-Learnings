  <diagram name="CREATING-RELATIONSHIPS" id="2HCugX94hei8ANrX5Aam">
    <mxGraphModel dx="2593" dy="-3097" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4mngNGIjWGy3Vcb5b8Tl-1" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Creating Relationships&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="5310" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4mngNGIjWGy3Vcb5b8Tl-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;1.Using merge to create relationship&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create a relation between person Michael Caine and movie The Dark Knight as ACTED_IN&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MATCH (m:Movie {title: &#39;The Dark Knight&quot;})&lt;br&gt;MATCH (p:Person {name: &#39;Michael Caine&#39;})&lt;br&gt;MERGE (p)-[:ACTED_IN]-&amp;gt;(m)&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Verify created relationship&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;i&gt;MATCH (p:Person {name:&quot;Michael Caine&quot;})-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;i style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;font&gt;RETURN m.title&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;i&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;b&gt;Note&lt;/b&gt;: Just double click in the UI to get the relationships or else you don&#39;t get it&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2. Relation ship direction matters&lt;/b&gt;&lt;br&gt;Show them movie --&amp;gt; person VS person --&amp;gt; Movie&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;with verification command&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; background-color: transparent; font-size: 25px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name:&quot;Michael Caine&quot;})&amp;lt;-[:ACTED_IN]-(m:Movie)&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;i style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;font&gt;RETURN m.title&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.Creating nodes and relationships with multiple clauses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create a person&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Chadwick Boseman acted in the movie called Black Panther&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name:&amp;nbsp;&#39;Chadwick Boseman&#39;})&lt;br&gt;MERGE (m:Movie {title:&amp;nbsp;&#39;Black Panther&#39;})&lt;br&gt;MERGE (p)-[:ACTED_IN]-(m)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4.Using merge to create nodes and relationship in single clause&lt;/b&gt;&lt;br&gt;Emily Blunt acted in the move A Quiet Place&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Emily Blunt&#39;})-[:ACTED_IN]-&amp;gt;(m: Movie {title: &#39;A Quite Place&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Verify&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Emily Blunt&#39;})-[:ACTED_IN]-&amp;gt;(m: Movie) RETURN m&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="720" y="5400" width="1120" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="uVU2EFaDtB7-v80gw7vM-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;&lt;b&gt;1. Suppose you want to create the LIKES relationship b/w a reference to a node a, and a reference to a node b where the direction of the relationship is from a to b&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;i style=&quot;font-size: 25px; letter-spacing: 0.25008px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;MERGE (a)-[:LIKES]-&amp;gt;(b)&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2.How do we create ACTED_IN relationship between movie node Mame &amp;amp; Person node Lucille Ball&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Lucille Ball&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {name: &#39;Mame&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p)-[:ACTED_IN]-(m)&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;b&gt;3. Create an ACTED_IN relationship between Daniel Kaluuya and movie Get Out. Make sure to check if the nodes exists or not before you create them&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Daniel Kaluuya&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {title: &#39;Get Out&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p)-[:ACTED_IN]-&amp;gt;(m)&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Daniel Kaluuya&#39;})-[:ACTED_IN]-(m:Movie {title: &#39;Get Out&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;RETURN p,m&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="560" y="6760" width="1710" height="930" as="geometry" />
        </mxCell>
        <mxCell id="P2Q5odnW3OE65LTks4Dy-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="480" y="6640" width="340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="UPDATING-PROPERTIES" id="w9ir5xSSmSs74ARqkGiW">
    <mxGraphModel dx="2074" dy="-3414" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sQkgO_Tl1zGo8lVx_jaE-1" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Updating Properties&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="5310" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sQkgO_Tl1zGo8lVx_jaE-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;1. Inline as part of the MERGE clause&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create node called Person with Michael Caine and node Called Movie with title as Batman Begins.&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent; font-size: 25px;&quot;&gt;Where&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent; font-size: 25px;&quot;&gt;Michael Caine acted in the movie Batman Begins with role name as Alfred Penny&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person {name:&amp;nbsp;&#39;Michael Caine&#39;})&lt;br&gt;MERGE (m:Movie {title:&amp;nbsp;&#39;Batman Begins&#39;})&lt;br&gt;MERGE (p)-[:ACTED_IN {role: [&#39;Alfred Penny&#39;]}]-&amp;gt;(m)&lt;br&gt;RETURN p,m&lt;br&gt;&lt;br&gt;&lt;b&gt;2.Using SET keyword&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Do the same but this time with SET keyword&lt;/font&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;WHERE p.name =&amp;nbsp;&#39;Michael Caine&#39; AND m.title =&amp;nbsp;&#39;The Dark Knight&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;SET r.roles = [&#39;Alfred Penny&#39;]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p, r, m&lt;br&gt;&lt;br&gt;&lt;b&gt;3.Setting multiple Properties&amp;nbsp;&lt;/b&gt;&lt;br&gt;To the same adding movie released date as 2008&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;WHERE p.name =&amp;nbsp;&#39;Michael Caine&#39; AND m.title =&amp;nbsp;&#39;The Dark Knight&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;SET r.roles = [&#39;Alfred Penny&#39;], m.released =&amp;nbsp;2008&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p, r, m&lt;br&gt;&lt;br&gt;&lt;b&gt;4.Updating properties&lt;/b&gt;&lt;br&gt;Just replace the role to &quot;Mr Alfred Penny&quot;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;WHERE p.name =&amp;nbsp;&#39;Michael Caine&#39; AND m.title =&amp;nbsp;&#39;The Dark Knight&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;SET r.roles = [&#39;Mr. Alfred Penny&#39;]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p, r, m&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;&lt;b&gt;5.Removing properties&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use REMOVE keyword to delete the properties&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;WHERE p.name =&amp;nbsp;&#39;Michael Caine&#39; AND m.title =&amp;nbsp;&#39;The Dark Knight&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;REMOVE r.roles&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p, r, m&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Using NULL instead of REMOVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;WHERE p.name =&amp;nbsp;&#39;Michael Caine&#39; AND m.title =&amp;nbsp;&#39;The Dark Knight&#39;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;SET&amp;nbsp; r.roles = NULL&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p, r, m&lt;/span&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="490" y="5390" width="1130" height="1530" as="geometry" />
        </mxCell>
        <mxCell id="lB_yt7nSyGWRLRasHRFs-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;1. Previously we created a movie node with title as &quot;Get Out&quot;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Modify this Cypher to use the SET clause to add the following properties to the Movie node:&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;tagline: Gripping, scary, witty and timely!&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;released: 2017&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MATCH (m:Movie {name: &quot;Get Out&quot;}) SET m.tagline = &quot;Gripping, scary, witty and timely!&quot;, m.released = 2017 RETURN m&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="440" y="7120" width="1410" height="340" as="geometry" />
        </mxCell>
        <mxCell id="R0ygD_refuj3z3inQbF_-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="360" y="7000" width="340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="MERGE-PROCESSING" id="kGjMFzK1JdfJnDXk0Eph">
    <mxGraphModel dx="2074" dy="-3414" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="W5uQZlZuKj82EKHwrwz5-1" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Customizing MERGE behavior&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;You can also specify behavior at runtime that enables you to set properties when the node is created or when the node is found. We can use the ON CREATE SET or ON MATCH SET conditions, or the SET keywords to set any additional properties.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;In this example, if the Person node for McKenna Grace does not exist, it is created and the createdAt property is set. If the node is found, then the updatedAt property is set. In both cases, the born property is set.&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="510" y="6810" width="1260" height="328" as="geometry" />
        </mxCell>
        <mxCell id="NexEZHSbgBKeOzzgTVLf-1" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Merge Processing&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=default;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="6280" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="NexEZHSbgBKeOzzgTVLf-2" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ON CREATE and ON MATCH Example&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Run this Cypher code at least 2 times to observe what properties are set. You can see the properties in table view.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;In this case we are going to create the property to the node called Persion with createAt &amp;amp; updateAt.&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;In simple if it’s a new node creation then createAt will get update with datetime(), likewise it will get&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;updated with updatedAt when there is match happens&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MERGE (p:&lt;span style=&quot;color: rgb(205, 89, 55);&quot;&gt;Person&lt;/span&gt; {name:&amp;nbsp;&#39;McKenna Grace&#39;})&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ON&amp;nbsp;CREATE&amp;nbsp;SET p.createAt&amp;nbsp;=&amp;nbsp;&lt;span style=&quot;color: rgb(30, 83, 163);&quot;&gt;datetime&lt;/span&gt;()&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ON&amp;nbsp;MATCH&amp;nbsp;SET p.updatedAt&amp;nbsp;=&amp;nbsp;&lt;span style=&quot;color: rgb(30, 83, 163);&quot;&gt;datetime&lt;/span&gt;()&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;SET p.born&amp;nbsp;=&amp;nbsp;&lt;span style=&quot;color: rgb(30, 83, 163);&quot;&gt;2006&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;RETURN p&lt;br&gt;&lt;br&gt;&lt;b&gt;Note&lt;/b&gt;: Run it again to show the usecase of ON CREATE, ON MATCH&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Setting multiple properties&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;If you want to set multiple properties for an ON CREATE SET or ON MATCH SET clause, you separate them by commas.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;For example:&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ON CREATE SET m.released = 2020, m.tagline = &#39;A great ride!&#39;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="510" y="7190" width="1350" height="730" as="geometry" />
        </mxCell>
        <mxCell id="YKlCOff6E4z4hT80r0YD-1" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;You have learned that you can use MERGE to create nodes and relationships in the graph. MERGE operations work by first trying to find a pattern in the graph. If the pattern is found then the data already exists and is not created. If the pattern is not found, then the data can be created.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Note&lt;/b&gt;: In simple always ensure you are checking for the node/properties first if they exists or not then go with merge other wise it will start throwing you error&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="510" y="6400" width="1260" height="328" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="DELETING-DATA" id="XuY3ycX0-YWEnl5zu4wQ">
    <mxGraphModel dx="2074" dy="-3414" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="8jxLNYT5KRw37bqf-lNm-1" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Deleting a node&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Suppose you have created a Person node for Jane Doe.&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Create node:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;MERGE (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Delete node:&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;DELETE p&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;b&gt;DELETE VS DETACH DELETE&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Run this Cypher code that recreates the relationship:&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MERGE (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MERGE (m:Movie {title:&amp;nbsp;&#39;The Matrix&#39;})&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MERGE (p)-[:ACTED_IN]-&amp;gt;(m)&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;RETURN p, m&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Using DELETE to delete the node&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Try running this Cypher code:&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;DELETE p&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Explain why you can&#39;t delete it then try with detach delete and explain the reason too&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Using DETACH DELETE to delete the node&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;DETACH DELETE p&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Delete labels&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Create node and set the label&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: inherit;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;MERGE (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;SET p:Developer&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;RETURN p&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Delete Label&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;MATCH (p:Person {name:&amp;nbsp;&#39;Jane Doe&#39;})&lt;/span&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;REMOVE p:Developer&lt;/span&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin-bottom: 0px; margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;RETURN p&lt;/font&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Delete all nodes and relationships&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size:inherit;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (n)&lt;br&gt;DETACH DELETE (n)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="690" y="6120" width="1000" height="1590" as="geometry" />
        </mxCell>
        <mxCell id="FaR_MHvp6PHO_0D-vLJd-1" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Deleting Data&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
