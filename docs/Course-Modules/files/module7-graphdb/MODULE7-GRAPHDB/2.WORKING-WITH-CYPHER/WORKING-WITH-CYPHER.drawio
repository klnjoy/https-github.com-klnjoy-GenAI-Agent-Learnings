  <diagram name="FINDING-RELATIONSHIPS" id="ILysGzQfQ0WwINv5I0hm">
    <mxGraphModel dx="2931" dy="-2464" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Finding Relationships&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="600" y="6680" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;1.Traversing Relationships&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="680" y="6855" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="880" y="7108" width="770" height="42" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-5" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Our domain model shows that the&amp;nbsp;&lt;i style=&quot;&quot;&gt;ACTED_IN&lt;/i&gt;&amp;nbsp;relationship goes in an outgoing direction from the&amp;nbsp;&lt;i style=&quot;&quot;&gt;Person&lt;/i&gt;&amp;nbsp;node so we can add the direction in our pattern. We often refer to this as a&amp;nbsp;&lt;strong style=&quot;&quot;&gt;traversal&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="800" y="6960" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;2.Returning Related Nodes&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="680" y="7260" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;( m )&lt;br&gt;RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="880" y="7513" width="780" height="67" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Our data model dictates that the node at the other end of that relationship will be Movie node, so we don’t necessarily need to specify the :Movie label in the node - instead we will use the variable m.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="800" y="7365" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-4" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;3. Specifying Node Labels&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="680" y="7680" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-5" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;( m:Movie )&lt;br&gt;RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="880" y="7933" width="830" height="97" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-6" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;That is, if we had multiple types of nodes at the end of the ACTED_IN relationships in our graph, we could make sure that we only return movies.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="800" y="7785" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-7" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;1.There is DIRECTED relationship between the Person nodes and Movie nodes -&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;it represents the people who directed the movies&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="720" y="8280" width="980" height="100" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-8" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="630" y="8120" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-9" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p: Person)-[:DIRECTED]-&amp;gt;(m:Movie) RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1920" y="8280" width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-10" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;2.who directed movie Cloud Atlas&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="720" y="8520" width="410" height="80" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-11" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;3.which movie Emil Eifrem acted in&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="720" y="8700" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-12" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:DIRECTED]-&amp;gt;(m: Movie {title: &#39;Cloud Atlas&#39;}) RETURN p&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="8480" width="810" height="160" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-13" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &quot;Emil Eifrem&quot;})-[:ACTED_IN]-&amp;gt;(m: Movie) RETURN m;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="8680" width="430" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="FILTERING-QUERIES" id="amARxmkdz8v9-jUc9GJb">
    <mxGraphModel dx="2280" dy="-2957" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wGCTRWf3WVCNwQxar4x0-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;1. Filtering by node labels.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Give all the people who worked in the movie called &#39;The Matrix&#39;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;br&gt;WHERE m.title=&#39;The Matrix&#39;&lt;br&gt;RETRUN p.name&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2.Filtering Using ranges&lt;/b&gt;&lt;br&gt;Find the movies and person nodes where the person acted in a movie that was released in 2008 or 2009&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;WHERE m.released = 2008 or m.released = 2009&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;RETRUN p.name&lt;br&gt;&lt;br&gt;Retrieve person name, movie title, movie released where movies released between 2000 and 2003&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE m.released &amp;lt;= 2003 AND m.released &amp;gt;= 2000&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name,m.title,m.released&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Filtering by existence of a property&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Return only movie nodes where Jack Nicholson acted in the movie and movie has tagline property&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE p.name = &#39;Jack Nicholson&#39; AND m.tagline IS NOT NULL&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN m.title, m.tagline&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;b&gt;4. Filtering with partial strings&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Find all actors in the graph where first name is Michael&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE p.name STARTS WITH &#39;Michael&#39;&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name&lt;br&gt;&lt;br&gt;&lt;b&gt;5.Filtering by patterns in the graph&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Find all the people who wrote a movie but did not direct that same movie&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:WROTE]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE NOT EXISTS ( (p)-[:DIRECTED]-(m))&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name,m.title&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="440" y="6510" width="1190" height="1340" as="geometry" />
        </mxCell>
        <mxCell id="wGCTRWf3WVCNwQxar4x0-2" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;FILTERING-QUERIES&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1400" y="6360" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wGCTRWf3WVCNwQxar4x0-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;6. Filtering with existing lists in the graph&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Name of the actor who played role Neo in the movie The Matrix&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;br&gt;WHERE &#39;Neo&#39; in r.roles AND m.name = &#39;The Matrix&quot;&lt;br&gt;RETRUN p.name, r.roles&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;7.What properties does a node or relationship have?&lt;/b&gt;&lt;br&gt;List of all property keys for a node&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)&lt;br&gt;RETURN p.name, keys(p)&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;br&gt;&lt;b&gt;8. What properties exist in the graph&lt;/b&gt;&lt;br&gt;CALL db.propertykeys()&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1800" y="6805" width="740" height="540" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;1. Retrieve all movies that have a released property value in 2000,2002,2004,2006,or 2008.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8230" width="980" height="100" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="440" y="8070" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (m:Movie) WHERE m.released in [2000,2002,2004,2006,2008] RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1730" y="8230" width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-4" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;2. Find all the people who born between 1970 to 1979&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8470" width="410" height="80" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-5" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;3.Select all the actors born after 1960 who acted in the movie title &quot;As Good as It Gets&quot;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8650" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-6" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person) WHERE p.born &amp;gt;= 1970 AND p.born &amp;lt; 1979 RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1250" y="8430" width="810" height="160" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-7" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie {title: &#39;As Good as It Gets&#39;}) WHERE p.born &amp;gt;= 1960 RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1250" y="8630" width="430" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="CREATING-NODES" id="aWtYNiYKGGYCisgPpf3v">
    <mxGraphModel dx="3771" dy="-2377" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="SW81ckvwEwbkTBD67QFz-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Note: Always use MERGE instead of CREATE # Create will fail if node exists but not MERGE&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;br&gt;1. Creating a node&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create a node to represent Michael Caine&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px; color: rgb(9, 9, 10);&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Michael Caine&#39;})&lt;/i&gt;&lt;br&gt;&lt;br&gt;Verifiy if the node exists or not&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person&amp;nbsp; {name: &quot;Michael Caine&quot;}) RETURN p.name&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2. Executing multiple cypher clauses&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Katie Holmes&#39;})&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {title: &#39;The Dark Knight&#39;})&lt;br&gt;RETURN p,m&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.Using CREATE instead of MERGE to create nodes&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;CREATE&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;i&gt;(p:Person {name: &#39;Katie Holmes&#39;})&lt;br&gt;RETURN p.name&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="7810" width="1340" height="730" as="geometry" />
        </mxCell>
        <mxCell id="SW81ckvwEwbkTBD67QFz-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="840" y="6800" width="1193.43" height="870" as="geometry" />
        </mxCell>
        <mxCell id="73TsRzi9T2cDly0NN05S-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;1. Create a person node Daniel Kaluuya&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;2. Verify the node existence&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); letter-spacing: normal;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &quot;Daniel Kaluuya&quot;}) RETURN p.name&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="840" y="8800" width="860" height="260" as="geometry" />
        </mxCell>
        <mxCell id="iwy-1nnxRAhXjcZTo1Ey-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="720" y="8680" width="340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
