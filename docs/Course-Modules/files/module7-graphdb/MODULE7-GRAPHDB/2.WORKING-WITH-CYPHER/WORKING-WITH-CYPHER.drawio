        <mxCell id="MAjoo9X92PtXpeahRK0Q-29" value="&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Georgia Pro&amp;quot;;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Name labels using CamelCase. Like &lt;b&gt;company&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/font&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Georgia Pro&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Name property keys and variables using camelCase. Like &lt;b&gt;personName&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/font&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot; face=&quot;Georgia Pro&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Georgia Pro&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;Use UPPERCASE for Cypher keywords. Like &lt;b&gt;NODE&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;verticalAlign=middle;fontSize=12;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1012.5" y="11340" width="730" height="160" as="geometry" />
        </mxCell>
        <mxCell id="MAjoo9X92PtXpeahRK0Q-30" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Note: Neo4j best practices include&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="880" y="11260" width="475" height="35" as="geometry" />
        </mxCell>
