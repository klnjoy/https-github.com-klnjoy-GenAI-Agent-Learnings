  <diagram id="DBLnOYYA81afP2Z_dW7m" name="FINDING-RELATIONSHIPS">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Finding Relationships&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="600" y="6680" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;1.Traversing Relationships&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="55" width="320" x="680" y="6855" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;()&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="42" width="770" x="880" y="7108" as="geometry" />
        </mxCell>
        <mxCell id="4yavMrCwrQ6wDmdJ0YGf-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;Our domain model shows that the&amp;nbsp;&lt;i style=&quot;&quot;&gt;ACTED_IN&lt;/i&gt;&amp;nbsp;relationship goes in an outgoing direction from the&amp;nbsp;&lt;i style=&quot;&quot;&gt;Person&lt;/i&gt;&amp;nbsp;node so we can add the direction in our pattern. We often refer to this as a&amp;nbsp;&lt;strong style=&quot;&quot;&gt;traversal&lt;/strong&gt;.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="880" x="800" y="6960" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;2.Returning Related Nodes&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="55" width="320" x="680" y="7260" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;( m )&lt;br&gt;RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="67" width="780" x="880" y="7513" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Our data model dictates that the node at the other end of that relationship will be Movie node, so we don’t necessarily need to specify the :Movie label in the node - instead we will use the variable m.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="880" x="800" y="7365" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=center;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;3. Specifying Node Labels&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="55" width="320" x="680" y="7680" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontStyle=2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &#39;Tom Hanks&#39;})-[:ACTED_IN]-&amp;gt;( m:Movie )&lt;br&gt;RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="97" width="830" x="880" y="7933" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=default;strokeColor=#3700CC;align=left;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#ffffff;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;That is, if we had multiple types of nodes at the end of the ACTED_IN relationships in our graph, we could make sure that we only return movies.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="880" x="800" y="7785" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;1.There is DIRECTED relationship between the Person nodes and Movie nodes -&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;it represents the people who directed the movies&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="980" x="720" y="8280" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="630" y="8120" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p: Person)-[:DIRECTED]-&amp;gt;(m:Movie) RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="770" x="1920" y="8280" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;2.who directed movie Cloud Atlas&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="410" x="720" y="8520" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;3.which movie Emil Eifrem acted in&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="430" x="720" y="8700" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:DIRECTED]-&amp;gt;(m: Movie {title: &#39;Cloud Atlas&#39;}) RETURN p&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="810" x="1440" y="8480" as="geometry" />
        </mxCell>
        <mxCell id="XqhCbnMhj5haHsoALxEd-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person {name: &quot;Emil Eifrem&quot;})-[:ACTED_IN]-&amp;gt;(m: Movie) RETURN m;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="430" x="1440" y="8680" as="geometry" />
        </mxCell>
        <mxCell id="jE9jjb9Hf4V49YsZykp2-1" edge="1" parent="1" source="XqhCbnMhj5haHsoALxEd-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" target="XqhCbnMhj5haHsoALxEd-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="taF1vFwHPgwCuRCI-xb9" name="FILTERING-QUERIES">
    <mxGraphModel dx="2280" dy="-2957" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wGCTRWf3WVCNwQxar4x0-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;1. Filtering by node labels.&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Give all the people who worked in the movie called &#39;The Matrix&#39;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;br&gt;WHERE m.title=&#39;The Matrix&#39;&lt;br&gt;RETRUN p.name&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2.Filtering Using ranges&lt;/b&gt;&lt;br&gt;Find the movies and person nodes where the person acted in a movie that was released in 2008 or 2009&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;WHERE m.released = 2008 or m.released = 2009&lt;/span&gt;&lt;br style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;RETRUN p.name&lt;br&gt;&lt;br&gt;Retrieve person name, movie title, movie released where movies released between 2000 and 2003&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE m.released &amp;lt;= 2003 AND m.released &amp;gt;= 2000&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name,m.title,m.released&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Filtering by existence of a property&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Return only movie nodes where Jack Nicholson acted in the movie and movie has tagline property&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE p.name = &#39;Jack Nicholson&#39; AND m.tagline IS NOT NULL&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN m.title, m.tagline&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;b&gt;4. Filtering with partial strings&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Find all actors in the graph where first name is Michael&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE p.name STARTS WITH &#39;Michael&#39;&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name&lt;br&gt;&lt;br&gt;&lt;b&gt;5.Filtering by patterns in the graph&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;Find all the people who wrote a movie but did not direct that same movie&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;MATCH (p:Person)-[:WROTE]-&amp;gt;(m:Movie)&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;WHERE NOT EXISTS ( (p)-[:DIRECTED]-(m))&lt;/span&gt;&lt;br style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;RETRUN p.name,m.title&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="440" y="6510" width="1190" height="1340" as="geometry" />
        </mxCell>
        <mxCell id="wGCTRWf3WVCNwQxar4x0-2" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;FILTERING-QUERIES&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1400" y="6360" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wGCTRWf3WVCNwQxar4x0-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;6. Filtering with existing lists in the graph&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Name of the actor who played role Neo in the movie The Matrix&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)-[r:ACTED_IN]-&amp;gt;(m:Movie)&lt;br&gt;WHERE &#39;Neo&#39; in r.roles AND m.name = &#39;The Matrix&quot;&lt;br&gt;RETRUN p.name, r.roles&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;7.What properties does a node or relationship have?&lt;/b&gt;&lt;br&gt;List of all property keys for a node&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;MATCH (p:Person)&lt;br&gt;RETURN p.name, keys(p)&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;br&gt;&lt;b&gt;8. What properties exist in the graph&lt;/b&gt;&lt;br&gt;CALL db.propertykeys()&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1800" y="6805" width="740" height="540" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-1" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;1. Retrieve all movies that have a released property value in 2000,2002,2004,2006,or 2008.&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8230" width="980" height="100" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-2" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="440" y="8070" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-3" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (m:Movie) WHERE m.released in [2000,2002,2004,2006,2008] RETURN m.title&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1730" y="8230" width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-4" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;2. Find all the people who born between 1970 to 1979&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8470" width="410" height="80" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-5" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;3.Select all the actors born after 1960 who acted in the movie title &quot;As Good as It Gets&quot;&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="8650" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-6" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person) WHERE p.born &amp;gt;= 1970 AND p.born &amp;lt; 1979 RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1250" y="8430" width="810" height="160" as="geometry" />
        </mxCell>
        <mxCell id="-hw_kkv79kjDAj_F22Oh-7" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;MATCH (p:Person)-[:ACTED_IN]-&amp;gt;(m:Movie {title: &#39;As Good as It Gets&#39;}) WHERE p.born &amp;gt;= 1960 RETURN p.name&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1250" y="8630" width="430" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4bwcRfVGhVTB-iDKRIH9" name="CREATING-NODES">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="SW81ckvwEwbkTBD67QFz-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;Note: Always use MERGE instead of CREATE # Create will fail if node exists but not MERGE&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;br&gt;1. Creating a node&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create a node to represent Michael Caine&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px; color: rgb(9, 9, 10);&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Michael Caine&#39;})&lt;/i&gt;&lt;br&gt;&lt;br&gt;Verifiy if the node exists or not&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person&amp;nbsp; {name: &quot;Michael Caine&quot;}) RETURN p.name&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2. Executing multiple cypher clauses&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Katie Holmes&#39;})&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {title: &#39;The Dark Knight&#39;})&lt;br&gt;RETURN p,m&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.Using CREATE instead of MERGE to create nodes&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;CREATE&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;i&gt;(p:Person {name: &#39;Katie Holmes&#39;})&lt;br&gt;RETURN p.name&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="730" width="1340" x="1288.7" y="8210" as="geometry" />
        </mxCell>
        <mxCell id="SW81ckvwEwbkTBD67QFz-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="870" width="1193.43" x="880" y="7300" as="geometry" />
        </mxCell>
        <mxCell id="73TsRzi9T2cDly0NN05S-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;1. Create a person node Daniel Kaluuya&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;2. Verify the node existence&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); letter-spacing: normal;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &quot;Daniel Kaluuya&quot;}) RETURN p.name&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="860" x="1288.7" y="9050" as="geometry" />
        </mxCell>
        <mxCell id="iwy-1nnxRAhXjcZTo1Ey-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="720" y="8680" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="UqOnLKv2h0cvSnTUxhP_" name="CREATING-RELATIONSHIPS">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4mngNGIjWGy3Vcb5b8Tl-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 35px;&quot;&gt;&lt;b&gt;Creating Relationships&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="440" x="840" y="5310" as="geometry" />
        </mxCell>
        <mxCell id="4mngNGIjWGy3Vcb5b8Tl-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;1.Using merge to create relationship&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create a relation between person Michael Caine and movie The Dark Knight as ACTED_IN&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MATCH (m:Movie {title: &#39;The Dark Knight&quot;})&lt;br&gt;MATCH (p:Person {name: &#39;Michael Caine&#39;})&lt;br&gt;MERGE (p)-[:ACTED_IN]-&amp;gt;(m)&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Verify created relationship&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;i&gt;MATCH (p:Person {name:&quot;Michael Caine&quot;})-[:ACTED_IN]-&amp;gt;(m:Movie)&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;i style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;font&gt;RETURN m.title&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;i&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&lt;b&gt;Note&lt;/b&gt;: Just double click in the UI to get the relationships or else you don&#39;t get it&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2. Relation ship direction matters&lt;/b&gt;&lt;br&gt;Show them movie --&amp;gt; person VS person --&amp;gt; Movie&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;with verification command&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;letter-spacing: 0.25008px; background-color: transparent; font-size: 25px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name:&quot;Michael Caine&quot;})&amp;lt;-[:ACTED_IN]-(m:Movie)&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;i style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; background-color: transparent;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;font&gt;RETURN m.title&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); letter-spacing: 0.25008px; font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3.Creating nodes and relationships with multiple clauses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create a person&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Chadwick Boseman acted in the movie called Black Panther&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name:&amp;nbsp;&#39;Chadwick Boseman&#39;})&lt;br&gt;MERGE (m:Movie {title:&amp;nbsp;&#39;Black Panther&#39;})&lt;br&gt;MERGE (p)-[:ACTED_IN]-(m)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;4.Using merge to create nodes and relationship in single clause&lt;/b&gt;&lt;br&gt;Emily Blunt acted in the move A Quiet Place&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Emily Blunt&#39;})-[:ACTED_IN]-&amp;gt;(m: Movie {title: &#39;A Quite Place&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;Verify&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Emily Blunt&#39;})-[:ACTED_IN]-&amp;gt;(m: Movie) RETURN m&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="1140" width="1120" x="700" y="5380" as="geometry" />
        </mxCell>
        <mxCell id="uVU2EFaDtB7-v80gw7vM-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontFamily=Georgia;labelBackgroundColor=none;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;&lt;b&gt;1. Suppose you want to create the LIKES relationship b/w a reference to a node a, and a reference to a node b where the direction of the relationship is from a to b&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;i style=&quot;font-size: 25px; letter-spacing: 0.25008px; color: light-dark(rgb(9, 9, 10), rgb(9, 9, 10)); background-color: transparent;&quot;&gt;MERGE (a)-[:LIKES]-&amp;gt;(b)&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;2.How do we create ACTED_IN relationship between movie node Mame &amp;amp; Person node Lucille Ball&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p:Person {name: &#39;Lucille Ball&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {name: &#39;Mame&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p)-[:ACTED_IN]-(m)&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10); letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;&lt;br&gt;&lt;b&gt;3. Create an ACTED_IN relationship between Daniel Kaluuya and movie Get Out. Make sure to check if the nodes exists or not before you create them&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Daniel Kaluuya&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (m:Movie {title: &#39;Get Out&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MERGE (p)-[:ACTED_IN]-&amp;gt;(m)&lt;br&gt;&lt;br&gt;&lt;b&gt;Verification&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;MATCH (p:Person {name: &#39;Daniel Kaluuya&#39;})-[:ACTED_IN]-(m:Movie {title: &#39;Get Out&#39;})&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;i&gt;RETURN p,m&lt;/i&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; color: rgb(9, 9, 10);&quot;&gt;&lt;font color=&quot;#09090a&quot;&gt;&lt;span style=&quot;font-size: 25px; letter-spacing: 0.25008px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="930" width="1710" x="560" y="6760" as="geometry" />
        </mxCell>
        <mxCell id="P2Q5odnW3OE65LTks4Dy-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=default;align=center;fontFamily=Georgia;labelBackgroundColor=none;fontColor=#FFFFFF;" value="&lt;p style=&quot;box-sizing: border-box; margin: 1.5rem 0px; letter-spacing: 0.25008px;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Challenges&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="480" y="6640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
