        <mxCell id="p_W4y9MiLB6mOaA00Ncs-1" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;1.Creating GraphDB&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;https://sandbox.neo4j.com/&lt;br&gt;&lt;br&gt;2. Wipe out the existing data if any&amp;nbsp;&lt;br&gt;MATCH (n)&lt;br&gt;DETACH DELETE (n)&lt;/font&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="540" y="410" width="480" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p_W4y9MiLB6mOaA00Ncs-2" value="&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;Create one Ec2 instance with 2C, 4GB RAM with ubuntu image and do the below&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: Georgia; font-size: 25px;&quot;&gt;sudo su -&lt;/span&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;apt update -y&lt;/font&gt;&lt;/p&gt;&lt;p lang=&quot;en-US&quot; style=&quot;margin: 0in;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 25px;&quot;&gt;apt install python3-pip&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 25px;&quot;&gt;apt install&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 25px;&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;python3-venv&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;mkdir&amp;nbsp; /opt/app&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;cd /opt/app&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;python3 -m venv .venv&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin-bottom:0px;margin-top:0px;&quot;&gt;&lt;span style=&quot;font-size: 25px; font-family: Georgia; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;source .venv/bin/activate&lt;br&gt;&lt;br&gt;Note: Do this at the last not required initially&lt;/span&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="440" y="705" width="920" height="340" as="geometry" />
