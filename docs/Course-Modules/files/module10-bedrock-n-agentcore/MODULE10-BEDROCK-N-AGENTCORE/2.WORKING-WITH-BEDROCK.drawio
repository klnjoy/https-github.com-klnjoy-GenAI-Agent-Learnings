        <mxCell id="uBZ9Y-R3uJwU3n4ArMUJ-4" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;1. Generate aws cli credentials&amp;nbsp;&lt;br&gt;2. Configure it in local using aws cli&lt;br&gt;&amp;nbsp;or else configure it in google colab&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="880" y="1330" width="660" height="180" as="geometry" />
