        <mxCell id="uBZ9Y-R3uJwU3n4ArMUJ-5" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;configure aws cli keys&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontStyle=1;gradientColor=#97d077;" parent="1" vertex="1">
          <mxGeometry x="1200" y="1880" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uBZ9Y-R3uJwU3n4ArMUJ-6" value="&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;from google.colab import userdata&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;import os&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;os.environ[&quot;AWS_ACCESS_KEY_ID&quot;] = userdata.get(&quot;AWS_ACCESS_KEY_ID&quot;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;os.environ[&quot;AWS_SECRET_ACCESS_KEY&quot;] = userdata.get(&quot;AWS_SECRET_ACCESS_KEY&quot;)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;os.environ[&quot;AWS_DEFAULT_REGION&quot;] = userdata.get(&quot;AWS_DEFAULT_REGION&quot;) or &quot;us-east-1&quot;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;sketch=1;curveFitting=1;jiggle=2;align=left;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="2120" y="1755" width="1630" height="425" as="geometry" />
        </mxCell>
        <mxCell id="uBZ9Y-R3uJwU3n4ArMUJ-7" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;install pre-req&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontStyle=1;gradientColor=#97d077;" parent="1" vertex="1">
          <mxGeometry x="1200" y="2565" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uBZ9Y-R3uJwU3n4ArMUJ-8" value="&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 35px;&quot;&gt;!pip install&amp;nbsp; boto3 botocore python-dotenv strands-agents strands-agents-tools&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;sketch=1;curveFitting=1;jiggle=2;align=left;fontStyle=1" parent="1" vertex="1">
