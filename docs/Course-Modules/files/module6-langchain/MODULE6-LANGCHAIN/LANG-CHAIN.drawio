        <mxCell id="P4laHd_uiYm5ivU-D7Dl-109" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" value="&lt;font style=&quot;font-size: 70px;&quot; face=&quot;Georgia&quot;&gt;&lt;b style=&quot;&quot;&gt;Decompossion Recursively Code&lt;/b&gt;&lt;/font&gt;" vertex="1">
