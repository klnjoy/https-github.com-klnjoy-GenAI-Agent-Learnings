pan style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;agent = create_agent(&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; model=model,&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; tools=[search_flights, search_hotels, calculate_trip_budget],&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; system_prompt=&quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; You are a travel planning assistant.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Use flight, hotel, and budget tools when planning trips.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Always give a clear final recommendation.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;)&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;response = agent.invoke({&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;messages&quot;: [&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;role&quot;: &quot;user&quot;,&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;content&quot;: &quot;Plan a 3-day trip from Hyderabad to Dubai with a budget of ₹70,000.&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; ]&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;})&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;print(response[&quot;messages&quot;][-1].content)&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;sketch=1;curveFitting=1;jiggle=2;fontColor=default;labelBackgroundColor=none;align=left;" vertex="1" parent="1">
