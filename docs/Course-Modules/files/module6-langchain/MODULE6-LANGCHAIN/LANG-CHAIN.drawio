        <mxCell id="oUA7OG4zq2OyRDvhiDau-57" value="&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;from langchain.agents import create_agent&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;from langchain_openai import ChatOpenAI&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;from langchain.tools import tool&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;model = ChatOpenAI(model=&quot;gpt-4o&quot;, temperature=0)&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;@tool&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;def get_weather(location: str) -&amp;gt; str:&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Get current weather for a given city or location.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Use this when the user asks about weather.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; return f&quot;Weather in {location}: Sunny, 72°F&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;@tool&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;def search_company_knowledge_base(query: str) -&amp;gt; str:&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Search internal company knowledge base.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; Use this when user asks about company policy, leave policy, refund policy, or support docs.&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; &quot;&quot;&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&amp;nbsp; &amp;nbsp; return f&quot;Knowledge base result for: {query}&quot;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;tools = [get_weather, search_company_knowledge_base]&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;336&quot; data-start=&quot;280&quot;&gt;&lt;font face=&quot;Georgia&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;agent = create_